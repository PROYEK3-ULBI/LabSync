# Konfigurasi Layanan Internal Face Service
APP_ENV=development
PORT=8001

# Keamanan Internal (Wajib cocok dengan backend Go)
INTERNAL_API_KEY=labsync-internal-secret-key

# Pipeline Model Biometrik
MODEL_NAME=ArcFace
MODEL_VERSION=1.0.0
DETECTOR_BACKEND=opencv

# Batasan Citra
MAX_FILE_SIZE_MB=5
MIN_IMAGE_WIDTH=160
MIN_IMAGE_HEIGHT=160

# Parameter Evaluasi & Kalibrasi
# PERINGATAN: Nilai threshold awal berbasis literatur/default ArcFace (Cosine distance).
# Jangan set IS_CALIBRATED=true sebelum pengujian empiris populasi target selesai dilakukan.
DEFAULT_SIMILARITY_THRESHOLD=0.40
IS_CALIBRATED=false
DEFAULT_STRATEGY=MIN_DISTANCE
