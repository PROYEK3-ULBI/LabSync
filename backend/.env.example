# Konfigurasi Lingkungan
APP_ENV=development
PORT=8000

# PostgreSQL Database (Supabase / Local)
# Contoh lokal: postgresql://postgres:postgres@localhost:5432/labsync?sslmode=disable
# Contoh Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labsync?sslmode=disable

# Keamanan & Autentikasi
JWT_SECRET=labsync-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRY_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
CORS_ALLOW_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
BODY_LIMIT_MB=10
RATE_LIMIT_MAX=60

# Komunikasi Internal Face Service & Enkripsi Biometrik
FACE_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=openssl rand -base64 32
FACE_SERVICE_TIMEOUT_SEC=10
BIOMETRIC_ENCRYPTION_KEY=01234567890123456789012345678901
